{
  "name": "indir-gitsin",
  "version": "1.5.0",
  "description": "İndir Gitsin - YouTube & YouTube Music İndirici",
  "private": true,
  "scripts": {
    "dev": "python server/app.py",
    "serve": "python -m http.server 8000",
    "cap:init": "npx cap init \"İndir Gitsin\" com.indirgitsin.app --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "build": "npx cap sync android",
    "bump": "node scripts/bump-version.js",
    "bump:patch": "node scripts/bump-version.js",
    "sync:readme": "node scripts/bump-version.js"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0"
  }
}
